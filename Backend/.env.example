

# === Infisical Secrets Manager (optional) ===
# If all three of these are set, secrets are pulled from Infisical at
# startup and override everything else in this file. Leave them unset to
# use the values below instead — this is the normal path for local dev.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SITE_URL=https://app.infisical.com

# === OpenAI / LLM Configuration ===
OPENAI_API_KEY=your-openai-api-key
EMBED_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-4  # or gpt-3.5-turbo, etc.

# === Paths & Directories ===
UPLOAD_DIR=uploads
INDEX_DIR=index_store
PARSED_DOC_DIR=parsed_docs

# === Database (for storing users, answers, feedback) ===
DATABASE_URL=your_database_url

# === Environment Control ===
ENV=development  # or production

# === Security ===
JWT_SECRET=your-super-secret-jwt
CLERK_SECRET_KEY=your-clerk-key-if-used

# === Email Configuration (for email verification) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=AI Pilot
FRONTEND_URL=http://localhost:3000

# === Supabase Configuration ===
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=documents
